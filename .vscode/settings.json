{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.organizeImports": "explicit"
  },
  "files.autoSave": "afterDelay",
  "editor.formatOnType": true,
  "editor.rulers": [100],
  "dart.flutterSdkPath": ".fvm/versions/3.47.7",
  "dart.debugSdkLibraries": true,
  "dart.lineLength": 100,
  "[dart]": {
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.rulers": [100],
    "editor.selectionHighlight": false,
    "editor.suggest.snippetsPreventQuickSuggestions": false,
    "editor.suggestSelection": "first",
    "editor.tabCompletion": "onlySnippets",
    "editor.wordBasedSuggestions": "off",
    "editor.defaultFormatter": "Dart-Code.dart-code"
  },
  "command-runner.terminal.name": "runCommand",
  "command-runner.commands": {
    "generate localization": "scripts/localize.sh",
    "flutter pub get": "scripts/get_all.sh",
    "get all": "scripts/get_all.sh",
    "clean all": "scripts/clean_all.sh"
  },
  "window.title": "${dirty}${activeEditorShort}",
  "git.autofetch": true,
  "gitlens.codeLens.scopes": ["document", "containers"],
  "gitlens.codeLens.recentChange.enabled": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "dart.debugExternalPackageLibraries": true
}
